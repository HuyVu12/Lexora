# Copy to .env locally; never commit real tokens.
# Provider and model remain unset until pilot.
MODEL_PROVIDER=
GENERATION_MODEL=
EMBEDDING_MODEL=
MODEL_API_KEY=
DATA_ROOT=data

# Opt-in 9Router routes for the local demo (HTTPS or loopback only).
9ROUTER_URL=
9ROUTER_KEY=
# Model aliases usable as --extract-model / --embedding-model values.
MODEL_OSS_120B=ollama/gpt-oss:120b
MODEL_EMB_GEMINI_1=gemini/gemini-embedding-001
